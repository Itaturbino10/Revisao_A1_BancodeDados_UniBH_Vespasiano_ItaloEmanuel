PRAGMA foreign_keys = ON;
CREATE TABLE CLIENTE (
    cpf_cliente VARCHAR(11) PRIMARY KEY,
    nome_cliente VARCHAR(100) NOT NULL,
    classe_cnh VARCHAR(20) NOT NULL,
    numero_cnh INTEGER NOT NULL,
    endereco_bairro VARCHAR(100) NOT NULL,
    endereco_cidade VARCHAR(100) NOT NULL,
    endereco_logradouro VARCHAR(100) NOT NULL,
    endereco_numero VARCHAR(100) NOT NULL
);

CREATE TABLE CATEGORIA_VEICULO (
    id_categoria INTEGER PRIMARY KEY AUTOINCREMENT,
    nome_categoria VARCHAR(100) NOT NULL,
    valor_categoria DECIMAL(10,2) NOT NULL
);

CREATE TABLE VEICULO (
    placa_veiculo VARCHAR(7) PRIMARY KEY,
    id_categoria INTEGER NOT NULL,
    modelo_veiculo VARCHAR(100) NOT NULL,
    ano_veiculo INTEGER NOT NULL,
    cor_veiculo VARCHAR(100) NOT NULL,
    marca_veiculo VARCHAR(100) NOT NULL,
    quilometragem_atual DECIMAL(10,3) NOT NULL,

    CONSTRAINT fk_veiculo_categoria
        FOREIGN KEY (id_categoria)
        REFERENCES CATEGORIA_VEICULO(id_categoria)
);

CREATE TABLE LOCACAO (
    id_locacao INTEGER PRIMARY KEY AUTOINCREMENT,
    cpf_cliente VARCHAR(11) NOT NULL,
    placa_veiculo VARCHAR(7) NOT NULL,
    data_retirada DATE NOT NULL,
    data_devolucao DATE NOT NULL,
    quilometragem_retirada DECIMAL(10,3) NOT NULL,
    valor_total DECIMAL(10,2) NOT NULL,

    CONSTRAINT fk_locacao_cliente
        FOREIGN KEY (cpf_cliente)
        REFERENCES CLIENTE(cpf_cliente),

    CONSTRAINT fk_locacao_veiculo
        FOREIGN KEY (placa_veiculo)
        REFERENCES VEICULO(placa_veiculo)
);

